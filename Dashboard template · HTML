    <div class="chart-box tall"><canvas id="sheetAnalysisChart"></canvas></div>
  </div>

  <div class="card">
    <h3>Sheet-wise Analysis <span class="tag" id="sheetAnalysisTableTag">sheets</span></h3>
    <div class="scroll-table">
    <table id="sheetAnalysisTable">
      <thead><tr><th>Sheet Name</th><th class="num">Expense</th><th class="num">Budget</th><th class="num">Entries</th><th class="num">Avg / Entry</th></tr></thead>
