  <div class="kpis" id="kpiRow"></div>

  <div class="grid">
    <div class="card">
      <h3>Expense Trend <span class="tag">by month</span></h3>
      <div class="chart-box tall"><canvas id="trendChart"></canvas></div>
    </div>
    <div class="card">
      <h3>Expense Type Split <span class="tag">by amount</span></h3>
      <div class="chart-box tall"><canvas id="expenseTypeChart"></canvas></div>
    </div>
  </div>

  <div class="grid">
    <div class="card">
      <h3>Top Clients by Expense <span class="tag">
