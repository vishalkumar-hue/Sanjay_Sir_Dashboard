      <thead><tr><th>Group</th><th class="num">Expense</th><th class="num">Expense Δ%</th><th class="num">Budget</th><th class="num">Entries</th></tr></thead>
      <tbody></tbody>
    </table>
    </div>
  </div>

  </div>

  <div id="tab-entries" class="tabpage">

  <div class="kpis" id="entriesKpiRow"></div>

  <div class="card">
    <h3>All Entries <span class="tag" id="entriesTableTag">entries</span></h3>
