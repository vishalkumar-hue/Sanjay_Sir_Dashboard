let cmpSelectedGroups = new Set();

function populateCmpGroups(){
  const dim = document.getElementById('cmpDimension').value;
  const rows = getFilteredRows();
  const agg = aggregateBy(rows, dim);
  let sortedForOrder = [...agg];
  if (dim === 'month'){
    const idx = new Map(MONTH_ORDER.map((m,i)=>[m,i]));
    sortedForOrder.sort((a,b)=> (idx.has(a.key)?idx.get(a.key):999) - (idx.has(b.key)?idx.get(b.key):999));
  } else if (dim === 'fyQuarter'){
    sortedForOrder.sort((a,b)=> fyQuarterSortKey(a.key) - fyQuarterSortKey(b.key));
  } else {
    sortedForOrder.sort((a,b)=>b.Expense-a.Expense);
  }
  const values = sortedForOrder.map(a=>a.key);

  const stillValid = new Set(values.filter(v => cmpSelectedGroups.has(v)));
  if (stillValid.size === 0 && values.length){
    const byExpense = [...agg].sort((a,b)=>b.Expense-a.Expense).slice(0,3).map(a=>a.key);
    byExpense.forEach(v=>stillValid.add(v));
  }
  cmpSelectedGroups = stillValid;

  const listEl = document.getElementById('cmpGroupsList');
  listEl.innerHTML = '';
  values.forEach(v=>{
    const row = document.createElement('label');
    row.className = 'ms-option';
    const cb = document.createElement('input');
    cb.type = 'checkbox';
    cb.value = v;
    cb.checked = cmpSelectedGroups.has(v);
    const span = document.createElement('span');
    span.textContent = v;
    row.appendChild(cb); row.appendChild(span);
    listEl.appendChild(row);
  });

  updateCmpGroupsBtn();
  renderComparisonTab();
}

