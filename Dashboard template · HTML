function rowMatches(row){
  return FILTER_DEFS.every(f => {
    const selected = activeFilters[f.key];
    if (!selected || selected.size === 0) return true;
    return selected.has(String(row[f.field] ?? ''));
  });
}

function getFilteredRows(){
  return ROWS.filter(rowMatches);
}

// drillFilter: sets a single exact-match filter (used when the person clicks
// a bar/segment on any chart) and jumps to the All Entries tab.
function drillFilter(key, value){
  if (value === undefined || value === null || value === '') return;
  activeFilters[key] = new Set([value]);
  const listEl = document.querySelector('#mspanel_' + key + ' .ms-list');
  const btn = document.getElementById('msbtn_' + key);
  if (listEl){
    listEl.querySelectorAll('input[type=checkbox]').forEach(c => { c.checked = (c.value === value); });
  }
  if (btn){ btn.textContent = value; btn.classList.add('active'); }
  const entriesBtn = document.querySelector('.tabbtn[data-tab="entries"]');
  if (entriesBtn) entriesBtn.click();
}

// ---------------- Client-side aggregation from row-level data ----------------
// aggregateBy: groups rows by a field and sums Expense (subtotal), Budget
// and Entries. Used for client/expenseType/sheet/month/quarter charts & tables.
function aggregateBy(rows, field){
  const map = new Map();
  rows.forEach(r => {
    const key = r[field] || '(blank)';
    if (!map.has(key)) map.set(key, {Expense:0, Budget:0, Entries:0});
    const g = map.get(key);
    g.Expense += (r.subtotal || 0);
    g.Budget += (r.budget || 0);
    g.Entries += 1;
  });
  return Array.from(map.entries()).map(([key, g]) => ({
    key, ...g,
    AvgPerEntry: g.Entries ? (g.Expense / g.Entries) : 0
  }));
}

