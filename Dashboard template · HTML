  const btn = document.getElementById('cmpGroupsBtn');
  const n = cmpSelectedGroups.size;
  btn.textContent = n === 0 ? 'Select groups' : (n === 1 ? [...cmpSelectedGroups][0] : n + ' groups selected');
  btn.classList.toggle('active', n>0);
}

