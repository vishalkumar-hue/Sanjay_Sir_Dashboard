      <input type="text" id="entriesSearch" placeholder="Search project code, client, expense type...">
      <div class="multiselect" style="min-width:190px;">
        <label>Columns</label>
        <button type="button" class="ms-btn" id="entriesColsBtn">Select columns</button>
        <div class="ms-panel" id="entriesColsPanel">
          <input type="text" class="ms-search" id="entriesColsSearch" placeholder="Search columns...">
          <div class="ms-actions">
            <button type="button" id="entriesColsAll">All</button>
            <button type="button" id="entriesColsClear">Clear</button>
            <button type="button" id="entriesColsDefault">Default</button>
          </div>
          <div class="ms-list" id="entriesColsList"></div>
        </div>
      </div>
    </div>
    <div class="scroll-table">
      <table id="entriesTable">
        <thead id="entriesTableHead"></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  </div>

</div>

<script>
// ROWS = row-level data coming from Python (one object per sheet row, already cleaned).
// MONTH_ORDER = chronological list of month labels, used to sort month-based charts/filters.
const ROWS = __ROWS_JSON__;
const MONTH_ORDER = __MONTH_ORDER_JSON__;
// ALL_HEADERS = every original Google Sheet column header (row.allColumns keys),
// used to power the "Columns" picker on the All Entries table.
const ALL_HEADERS = __ALL_HEADERS_JSON__;
const DEFAULT_ENTRY_COLUMNS = __DEFAULT_COLUMNS_JSON__;

// fmtCr: formats a raw rupee number for display, auto-picking the right unit -
// "₹X.XX Cr" at 1 Cr (1e7) or more, "₹X.XX L" (Lakh) from 1 Lakh (1e5) up to 1 Cr,
// and "₹X.XX K" below 1 Lakh.
const fmtCr = v => {
  if (v === null || v === undefined || isNaN(v)) return '-';
  const abs = Math.abs(v);
  if (abs >= 1e7){
    return '₹' + (v/1e7).toFixed(2) + ' Cr';
  }
  if (abs >= 1e5){
    return '₹' + (v/1e5).toFixed(2) + ' L';
  }
  return '₹' + fmtNum(Math.round(v));
};
// fmtNum: formats a number using Indian digit grouping (e.g. 12,34,567).
const fmtNum = v => Number(v).toLocaleString('en-IN');

// parseTopN: reads a Top-N control's value (typed or picked from the
// datalist) and returns a positive integer, or Infinity for "All"/blank/
// invalid input (which means "no limit, show everything").
function parseTopN(value){
  if (value === null || value === undefined) return Infinity;
  const v = String(value).trim().toLowerCase();
  if (v === '' || v === 'all' || v === '0') return Infinity;
  const n = parseInt(v, 10);
  return (isNaN(n) || n <= 0) ? Infinity : n;
}

Chart.defaults.color = '#8ea0c2';
Chart.defaults.font.family = "'Segoe UI', Arial, sans-serif";
Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';

Chart.register(ChartDataLabels);
Chart.defaults.set('plugins.datalabels', { display: false });

const COLORS = {
  gold:'#d9a441', teal:'#33b8a8', coral:'#e0665f', violet:'#8b7ee8', blue:'#4f8bd0'
};
