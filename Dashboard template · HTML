// fyQuarterSortKey: sorts "2025-26 Q3" style labels chronologically by the
// starting year of the FY, then the quarter number.
function fyQuarterSortKey(q){
  const m = /(\d{4})\D+\d{2,4}\D+Q(\d)/.exec(String(q||''));
  if (!m) return Number.MAX_SAFE_INTEGER;
  return parseInt(m[1],10)*10 + parseInt(m[2],10);
}

// ---------------- Generic filter system (shared across all tabs) ----------------
const FILTER_DEFS = [
  {key:'fy', label:'Financial Year', field:'fy'},
  {key:'quarter', label:'Quarter', field:'quarter'},
  {key:'month', label:'Month', field:'month', order: MONTH_ORDER},
  {key:'sheetName', label:'Sheet Name', field:'sheetName'},
  {key:'client', label:'Client', field:'client'},
  {key:'projectType', label:'Project Type', field:'projectType'},
  {key:'entity', label:'Entity', field:'entity'},
  {key:'expenseType', label:'Expense Type', field:'expenseType'},
  {key:'projectCode', label:'Project Code', field:'projectCode'},
];

const activeFilters = {};
FILTER_DEFS.forEach(f => activeFilters[f.key] = new Set());

function uniqueValues(field, order){
  const vals = Array.from(new Set(ROWS.map(r => r[field]).filter(v => v !== null && v !== undefined && v !== '')));
  if (order && order.length){
    const idx = new Map(order.map((m,i)=>[m,i]));
    vals.sort((a,b) => (idx.has(a)?idx.get(a):999) - (idx.has(b)?idx.get(b):999));
  } else {
    vals.sort();
  }
  return vals;
}

function triggerFilterChange(){
  const active = document.querySelector('.tabpage.active');
