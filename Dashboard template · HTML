    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      document.querySelectorAll('.ms-panel.open').forEach(p => { if (p !== panel) p.classList.remove('open'); });
      panel.classList.toggle('open');
    });
    panel.addEventListener('click', (e) => e.stopPropagation());

    wrap.querySelector('.ms-search').addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase();
      listEl.querySelectorAll('.ms-option').forEach(opt => {
        opt.style.display = opt.textContent.toLowerCase().includes(term) ? '' : 'none';
      });
    });

    wrap.querySelector('.ms-all').addEventListener('click', () => {
      listEl.querySelectorAll('.ms-option').forEach(opt => {
        if (opt.style.display !== 'none') opt.querySelector('input').checked = true;
      });
