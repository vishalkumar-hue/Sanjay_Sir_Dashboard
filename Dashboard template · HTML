  sunset:  { name:'Sunset Warm',     bg:'#1a1210', panel:'#241a17', panel2:'#2e211c', border:'#4a332a', text:'#f5e9e2', muted:'#c79b83', gold:'#e0a441', teal:'#4fb6ac', coral:'#e0665f', violet:'#c98be0', grid:'rgba(255,255,255,0.06)', swatch:'#7a3b23' },
  light:   { name:'Light',           bg:'#f4f6fb', panel:'#ffffff', panel2:'#eef1f8', border:'#d7deea', text:'#1b2434', muted:'#5b6b85', gold:'#b9791f', teal:'#128a7d', coral:'#c23f38', violet:'#6a5acd', grid:'rgba(0,0,0,0.07)', swatch:'#f4f6fb' },
};
const THEME_ORDER = ['dark','midnight','forest','sunset','light'];
const THEME_STORAGE_KEY = 'expenseDashboardTheme';
let currentDatalabelColor = THEMES.dark.text;

function applyTheme(name, skipRerender){
  const t = THEMES[name] || THEMES.dark;
  const root = document.documentElement.style;
  root.setProperty('--bg', t.bg);
  root.setProperty('--panel', t.panel);
  root.setProperty('--panel-2', t.panel2);
  root.setProperty('--border', t.border);
  root.setProperty('--text', t.text);
  root.setProperty('--muted', t.muted);
  root.setProperty('--gold', t.gold);
  root.setProperty('--teal', t.teal);
  root.setProperty('--coral', t.coral);
  root.setProperty('--violet', t.violet);
  root.setProperty('--grid', t.grid);

  Chart.defaults.color = t.muted;
  Chart.defaults.borderColor = t.grid;
  currentDatalabelColor = t.text;

  const dot = document.getElementById('themeDot');
  const label = document.getElementById('themeBtnLabel');
  if (dot) { dot.style.background = t.gold; dot.style.boxShadow = '0 0 5px ' + t.gold; }
  if (label) label.textContent = t.name;

  document.querySelectorAll('.theme-option').forEach(el=>{
    el.classList.toggle('selected', el.dataset.theme === name);
  });

  try { localStorage.setItem(THEME_STORAGE_KEY, name); } catch(e) {}

  if (!skipRerender){
    const active = document.querySelector('.tabpage.active');
    renderTab(active ? active.id : 'tab-overview');
  }
}

function buildThemePanel(){
  const panel = document.getElementById('themePanel');
  panel.innerHTML = '';
  THEME_ORDER.forEach(key=>{
    const t = THEMES[key];
    const row = document.createElement('div');
    row.className = 'theme-option';
    row.dataset.theme = key;
    row.innerHTML = `<span class="swatch" style="background:${t.swatch}"></span><span>${t.name}</span>`;
    row.addEventListener('click', ()=>{
      applyTheme(key);
      document.getElementById('themePanel').classList.remove('open');
    });
    panel.appendChild(row);
  });
}

document.getElementById('themeBtn').addEventListener('click', (e)=>{
  e.stopPropagation();
  document.querySelectorAll('.ms-panel.open').forEach(p=>p.classList.remove('open'));
  document.getElementById('themePanel').classList.toggle('open');
});
document.getElementById('themePanel').addEventListener('click', e=>e.stopPropagation());

buildThemePanel();
let savedTheme = 'dark';
try { savedTheme = localStorage.getItem(THEME_STORAGE_KEY) || 'dark'; } catch(e) {}
applyTheme(savedTheme, true);

buildFilterBar();
buildEntriesColsPanel();
document.getElementById('periodLabel').textContent = '__PERIOD_LABEL__';
renderAll();
</script>
