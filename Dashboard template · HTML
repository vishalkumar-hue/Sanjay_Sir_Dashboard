function renderComparisonTab(){
  const dim = document.getElementById('cmpDimension').value;
  const rows = getFilteredRows();
  const agg = aggregateBy(rows, dim);
  const map = new Map(agg.map(a=>[a.key, a]));

  let selected = Array.from(cmpSelectedGroups);
  if (dim === 'month'){
    const idx = new Map(MONTH_ORDER.map((m,i)=>[m,i]));
    selected.sort((a,b)=> (idx.has(a)?idx.get(a):999) - (idx.has(b)?idx.get(b):999));
  } else if (dim === 'fyQuarter'){
    selected.sort((a,b)=> fyQuarterSortKey(a) - fyQuarterSortKey(b));
  } else {
    selected.sort();
  }

  const groups = selected.map(key => ({ key, ...(map.get(key) || {Expense:0, Budget:0, Entries:0}) }));

  const row = document.getElementById('cmpKpiRow');
  row.innerHTML = '';
  if (groups.length){
    const totalExpense = groups.reduce((a,b)=>a+b.Expense,0);
    const totalBudget = groups.reduce((a,b)=>a+b.Budget,0);
    const best = [...groups].sort((a,b)=>b.Expense-a.Expense)[0];
    const worst = [...groups].sort((a,b)=>a.Expense-b.Expense)[0];
    const items = [
      {label:'Groups Selected', value: fmtNum(groups.length)},
      {label:'Combined Expense', value: fmtCr(totalExpense)},
      {label:'Combined Budget', value: fmtCr(totalBudget)},
      {label:'Highest Expense', value: best ? `${best.key} (${fmtCr(best.Expense)})` : '-'},
      {label:'Lowest Expense', value: worst ? `${worst.key} (${fmtCr(worst.Expense)})` : '-'},
    ];
    items.forEach(it=>{
      const div = document.createElement('div'); div.className='kpi';
      div.innerHTML = `<div class="label">${it.label}</div><div class="value">${it.value}</div>`;
      row.appendChild(div);
    });
  }

  destroy('cmp');
  const ctx = document.getElementById('cmpChart');
  charts.cmp = new Chart(ctx, {
    type:'bar',
    data:{
      labels:['Expense (₹ L)','Budget (₹ L)','Entries'],
      datasets: groups.map((g,i)=>({
        label: g.key,
        data: [+(g.Expense/1e5).toFixed(2), +(g.Budget/1e5).toFixed(2), g.Entries],
        backgroundColor: PALETTE[i % PALETTE.length],
        borderRadius:5
      }))
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      layout:{padding:{top:18}},
      plugins:{
        legend:{position:'bottom'},
        datalabels:{ display:true, clip:true, color: currentDatalabelColor, font:{size:9, weight:'600'}, anchor:'end', align:'top', formatter:(v)=> v }
      }
    }
  });

  const tbody = document.querySelector('#cmpTable tbody');
  tbody.innerHTML = '';
  const baseline = groups.length ? groups[0] : null;
  groups.forEach((g,i)=>{
    const tr = document.createElement('tr');
    let expDeltaHtml = '-';
    if (i===0){
      expDeltaHtml = '<span class="delta">baseline</span>';
    } else if (baseline){
      const expDelta = baseline.Expense ? ((g.Expense-baseline.Expense)/Math.abs(baseline.Expense)*100) : null;
      expDeltaHtml = expDelta===null ? '-' : `<span class="${expDelta>=0?'up':'down'}">${expDelta>=0?'+':''}${Math.round(expDelta)}%</span>`;
    }
    tr.innerHTML = `<td>${g.key}</td><td class="num">${fmtCr(g.Expense)}</td><td class="num">${expDeltaHtml}</td><td class="num">${fmtCr(g.Budget)}</td><td class="num">${fmtNum(g.Entries)}</td>`;
    tbody.appendChild(tr);
  });
  document.getElementById('cmpTableTag').textContent = groups.length + ' groups, vs ' + (baseline ? baseline.key : 'first selected');
}

