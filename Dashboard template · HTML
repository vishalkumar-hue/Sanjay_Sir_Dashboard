  </div>

  <div class="kpis" id="cmpKpiRow"></div>

  <div class="card">
    <h3>Side-by-Side <span class="tag">expense, budget, entries</span></h3>
    <div class="chart-box tall"><canvas id="cmpChart"></canvas></div>
  </div>

  <div class="card">
    <h3>Comparison Table <span class="tag" id="cmpTableTag">groups, vs first selected</span></h3>
