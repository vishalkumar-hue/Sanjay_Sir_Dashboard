    </div>
  </div>

  <div class="card">
    <h3>Client-wise Summary <span class="tag" id="clientTableTag">clients</span></h3>
    <div class="scroll-table">
    <table id="clientTable">
      <thead><tr><th>Client</th><th class="num">Entries</th><th class="num">Budget</th><th class="num">Expense</th><th class="num">Avg / Entry</th></tr></thead>
      <tbody></tbody>
    </table>
    </div>
  </div>

  </div>

  <div id="tab-monthly" class="tabpage">

  <div class="kpis" id="monthlyKpiRow"></div>

  <div class="card">
    <h3>Expense by Month <span class="tag">monthly trend</span></h3>
    <div class="chart-box tall"><canvas id="monthlyChart"></canvas></div>
  </div>

  <div class="card">
    <h3>Monthly Trend Table <span class="tag" id="monthlyTableTag">months</span></h3>
    <div class="scroll-table">
    <table id="monthlyTable">
      <thead><tr><th>Month</th><th class="num">Expense</th><th class="num">Budget</th><th class="num">Entries</th><th class="num">MoM Expense Δ</th></tr></thead>
      <tbody></tbody>
    </table>
    </div>
  </div>

  </div>

  <div id="tab-expensetype" class="tabpage">

  <div class="kpis" id="expenseTypeKpiRow"></div>

  <div class="card">
    <h3>Expense by Type <span class="tag">bar chart</span></h3>
    <div class="chart-box tall"><canvas id="expenseTypeAnalysisChart"></canvas></div>
  </div>

  <div class="card">
    <h3>Expense Type Analysis <span class="tag" id="expenseTypeTableTag">types</span></h3>
